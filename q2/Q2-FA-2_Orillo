class Patient():
    def __init__(self, name, bill_amount):
        self.__name = name
        self.__bill_amount = bill_amount

    def get_name(self):
        return self.__name

    def set_name(self, name):
        self.__name = name

    def get_bill_amount(self):
        return self.__bill_amount

    def set_bill_amount(self, bill_amount):
        if bill_amount < 0:
            print("Bill amount cannot be negative.")
            return
        self.__bill_amount = bill_amount
        print(f"Bill amount set to: {self.__bill_amount}")

    def calculate_bill(self):
        return self.__bill_amount

class SeniorPatient(Patient):
    def calculate_bill(self):
        return super().calculate_bill() * 0.8  

class PhilHealth(Patient):
    def calculate_bill(self):
        return super().calculate_bill() * 0.85

regular_patient = Patient("Juan Dela Cruz", 15000)
senior_patient = SeniorPatient("Maria Santos", 15000)
philhealth_patient = PhilHealth("Pedro Reyes", 15000)

patients = [regular_patient, senior_patient, philhealth_patient]

print("\nHospital Billing System:")

for patient in patients:
    print(f"\nPatient Name: {patient.get_name()}")
    print(f"Original Bill Amount: {patient.get_bill_amount()}")
    print(f"Final Bill Amount after Discount: {patient.calculate_bill()}")
